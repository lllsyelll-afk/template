  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build.admin": "tsc --noEmit && vite build --mode admin",
    "build.web": "tsc --noEmit && vite build --mode web",
    "build.android": "tsc --noEmit && vite build --mode android && cap sync android && cd android && gradlew assembleRelease",
    "cap.add.android": "vite build && cap add android && cap sync",
    "cap.add.ios": "vite build && cap add ios && cap sync",
    "cap.open.android": "cap open android",
    "cap.open.ios": "cap open ios",
    "cap.sync": "vite build && cap sync",
    "cap.assets": "capacitor-assets generate android",
    "check": "tsc --noEmit",
    "dev": "concurrently -n app,web,admin -c blue,yellow,white \"npm run dev.app\" \"npm run dev.web\" \"npm run dev.admin\"",
    "dev.admin": "vite --host 0.0.0.0 --mode admin",
    "dev.app": "vite --host 0.0.0.0",
    "dev.web": "vite --host 0.0.0.0 --mode web",
    "electron": "vite --mode electron",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "detect:translations": "tsx scripts/detect-untranslated-keys.ts"
  }
