# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment Settings
ENV=development # Application environment (development/production)
API_PORT=45231 # Port for the API server

VITE_API_VERSION=v1 # API version to use

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017 # MongoDB connection string
MONGODB_DB=my_database # Database name (Update this for your new project)

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Secret for token signing (generate a new one for production)
JWT_SECRET= # Secret key for JWT token generation

# Encryption key for sensitive data storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY= # 32-byte encryption key

# Active SMS Provider
# Options: local (dev only), clicksend, plivo, twilio
SMS_PROVIDER=local

# --- ClickSend SMS Provider ---
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_SENDER_ID=

# --- Plivo SMS Provider ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SENDER_NUMBER=

# --- Twilio SMS Provider ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Cloudinary Storage ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# --- AWS S3 Storage ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=true

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================

PAY_PROVIDER=chargily

# --- Chargily Payment Provider ---
CHARGILY_SECRET_KEY=
CHARGILY_REDIRECT_URL=
CHARGILY_WEBHOOK_URL=

# --- Stripe Payment Provider ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_REDIRECT_URL=

# =============================================================================
# RATE LIMITING & API SECURITY
# =============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_SMS=3
RATE_LIMIT_UPLOAD=20

# =============================================================================
# CLI CONFIGURATION
# =============================================================================

CLI_API_KEY=
CLI_API_URL=http://localhost:45231/api
CLI_API_VERSION=v1

# =============================================================================
# PUSH NOTIFICATIONS (VAPID)
# =============================================================================

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# =============================================================================
# GOOGLE CALENDAR INTEGRATION
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# =============================================================================
# NETWORK & SECURITY
# =============================================================================

TRUSTED_PROXIES=

# =============================================================================
# CAPTCHA CONFIGURATION (Turnstile)
# =============================================================================

TURNSTILE_SECRET_KEY=

NATIVE_APP_KEY=
